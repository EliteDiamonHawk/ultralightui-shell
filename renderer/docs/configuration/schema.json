{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "title": "Aether configuration",
  "description": "Canonical JSON schema for Aether configuration files.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "wallpaper": {
      "type": "array",
      "description": "Wallpaper profiles. Each profile resolves to one or more desktop windows.",
      "items": { "$ref": "#/$defs/wallpaper" }
    },
    "windows": {
      "type": "array",
      "description": "Generic Aether windows.",
      "items": { "$ref": "#/$defs/genericWindow" }
    },
    "widgets": {
      "type": "array",
      "description": "Desktop widget windows.",
      "items": { "$ref": "#/$defs/widget" }
    },
    "variables": {
      "type": "object",
      "description": "JSON values exposed to bridge-enabled pages.",
      "propertyNames": { "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
      "additionalProperties": true
    },
    "cues": {
      "type": "array",
      "description": "Chronos cue names accepted by bridge-enabled pages.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "HTTP, HTTPS, or file URL. Bare host names become HTTPS URLs."
    },
    "threadGroup": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backend-ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "control-routes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/v1/" }
        },
        "runtime-commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "showWindow",
              "hideWindow",
              "pause",
              "resume",
              "status",
              "reload"
            ]
          }
        }
      }
    },
    "anchor": {
      "type": "string",
      "enum": [
        "top-left",
        "top",
        "top-right",
        "left",
        "center",
        "right",
        "bottom-left",
        "bottom",
        "bottom-right"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mouse": { "enum": ["none", "native", "forwarded"] },
        "keyboard": { "enum": ["none", "native", "forwarded"] },
        "focus": { "enum": ["never", "on-show", "on-reveal", "on-click"] },
        "click-through": { "type": "boolean" }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "focus": { "type": "boolean" },
        "visibility": { "type": "boolean" },
        "geometry": { "type": "boolean" },
        "lifecycle": { "type": "boolean" }
      }
    },
    "workArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "edge": { "enum": ["top", "bottom", "left", "right"] },
        "thickness": { "type": "integer", "minimum": 0 }
      }
    },
    "genericWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "url": { "$ref": "#/$defs/url" },
        "thread-group": { "$ref": "#/$defs/threadGroup" },
        "title": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "monitor": { "type": "integer", "minimum": 1 },
        "coordinate-space": { "enum": ["monitor", "work-area", "virtual-screen"] },
        "anchor": { "$ref": "#/$defs/anchor" },
        "x-unit": { "enum": ["pixels", "percent"] },
        "y-unit": { "enum": ["pixels", "percent"] },
        "width-unit": { "enum": ["pixels", "percent"] },
        "height-unit": { "enum": ["pixels", "percent"] },
        "framed": { "type": "boolean" },
        "transparent": { "type": "boolean" },
        "resizable": { "type": "boolean" },
        "show-in-taskbar": { "type": "boolean" },
        "placement": { "enum": ["desktop", "top-level", "toplevel", "window"] },
        "z-order": { "enum": ["bottom", "below", "normal", "top", "above", "topmost", "topmost-when-focused", "focus"] },
        "initial-visible": { "type": "boolean" },
        "hidden-behavior": { "enum": ["retain", "none", "pause", "suspend", "unload"] },
        "suspend-on-fullscreen": { "type": "boolean" },
        "input": { "$ref": "#/$defs/input" },
        "notifications": { "$ref": "#/$defs/notifications" },
        "work-area": { "$ref": "#/$defs/workArea" },
        "bridge": { "$ref": "#/$defs/bridge" }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "x",
        "y",
        "anchor",
        "monitor",
        "url"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "pos-scaled": { "type": "boolean" },
        "pos-scale": { "type": "boolean" },
        "size-scaled": { "type": "boolean" },
        "size-scale": { "type": "boolean" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "monitor": { "type": "integer", "minimum": 1 },
        "url": { "$ref": "#/$defs/url" },
        "transparent": { "type": "boolean" },
        "thread-group": { "$ref": "#/$defs/threadGroup" },
        "bridge": { "$ref": "#/$defs/bridge" }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["pos-scaled"] },
            { "required": ["pos-scale"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["size-scaled"] },
            { "required": ["size-scale"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["width"] },
            { "required": ["w"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["height"] },
            { "required": ["h"] }
          ]
        }
      ]
    },
    "widget": {
      "allOf": [
        { "$ref": "#/$defs/geometry" }
      ],
      "unevaluatedProperties": false
    },
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "url": { "$ref": "#/$defs/url" },
        "mode": {
          "type": "string",
          "enum": ["span", "all", "single"]
        },
        "monitor": {
          "type": "integer",
          "minimum": 1
        },
        "monitor-urls": {
          "type": "object",
          "patternProperties": {
            "^[1-9][0-9]*$": { "$ref": "#/$defs/url" }
          },
          "additionalProperties": false
        },
        "window-ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transparent": { "type": "boolean" },
        "thread-group": { "$ref": "#/$defs/threadGroup" },
        "bridge": { "$ref": "#/$defs/bridge" }
      }
    }
  }
}
