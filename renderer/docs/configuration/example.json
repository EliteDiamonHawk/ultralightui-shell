{
  "variables": {
    "theme": "dark",
    "refresh-ms": 1000
  },
  "cues": ["menu.toggle", "next"],
  "wallpaper": [
    {
      "url": "https://example.com/wallpaper",
      "mode": "all",
      "monitor-urls": {
        "1": "https://example.com/wallpaper/primary",
        "2": "https://example.com/wallpaper/secondary"
      },
      "transparent": false,
      "thread-group": "desktop"
    }
  ],
  "widgets": [
    {
      "x": 50,
      "y": 8,
      "pos-scaled": true,
      "size-scaled": false,
      "anchor": "top",
      "width": 520,
      "height": 180,
      "monitor": 1,
      "url": "https://example.com/widget",
      "transparent": true,
      "thread-group": "desktop"
    }
  ],
  "windows": [
    {
      "id": "clock",
      "url": "https://example.com/window",
      "geometry": {
        "coordinate-space": "monitor",
        "monitor": 1,
        "anchor": "top",
        "position": { "x": 50, "y": 8, "unit": "percent" },
        "size": { "width": 520, "height": 180, "unit": "pixels" }
      },
      "surface": {
        "kind": "top-level",
        "z-order": "normal"
      },
      "input": { "mouse": "native", "keyboard": "native", "focus": "on-click" },
      "notifications": { "focus": true }
    }
  ]
}
